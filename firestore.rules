rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // UID do administrador-mestre (sempre acesso total, à prova de bloqueio)
    function master()    { return request.auth != null && request.auth.uid == 'l3Cnzaf42DRBK6MIHiXfnHxg2Rk2'; }
    function signedIn() { return request.auth != null; }
    function perfil()  { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo()   { return master() || (signedIn() && perfil().ativo == true); }
    function admin()   { return master() || (signedIn() && perfil().papel == 'admin'); }
    function editor()  { return master() || (ativo() && (perfil().papel == 'admin' || perfil().papel == 'editor')); }
    function adminEmail(){ return request.auth.token.email == 'leo85filipe@gmail.com'; }

    // ---- Perfis de usuário ----
    match /usuarios/{uid} {
      // cada um lê o próprio perfil; admin lê todos
      allow read:   if signedIn() && (request.auth.uid == uid || admin());
      // ao se cadastrar, a pessoa cria SÓ o próprio doc, como 'leitor' e PENDENTE
      // (exceção: o e-mail do administrador e o UID-mestre entram já aprovados)
      allow create: if signedIn() && request.auth.uid == uid
                    && ( adminEmail() || master()
                         || (request.resource.data.papel == 'leitor'
                             && request.resource.data.ativo == false) );
      // só admin altera papel / libera / bloqueia
      allow update, delete: if admin();
    }

    // ---- Dados do app (frota, mapas, contadores, docs, confiabilidade…) ----
    match /mapas/{doc} {
      allow read:  if ativo();
      allow write: if editor();
    }
  }
}
